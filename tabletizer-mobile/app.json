{
  "expo": {
    "name": "tabletizer-mobile",
    "slug": "tabletizer-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./logo_final.png",
    "scheme": "tabletizermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./logo_final.png",
      "bundleIdentifier": "com.mehmedaltug.tabletizer"
    },
    "android": {
      "icon": "./logo_final.png",
      "package": "com.mehmedaltug.tabletizer",
      "adaptiveIcon": {
        "backgroundColor": "#0C1118",
        "foregroundImage": "./logo_final.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./logo_final.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1118",
          "image": "./logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
